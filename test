#include<bits/stdc++.h>
using namespace std;
int n,m,a[100];
int used[100];
void inkq(){
	for(int i=1;i<=n;i++) cout<<a[i]<<" ";
	cout<<endl;
}
void Try(int i){
	for(int j=1;j<=n;j++){
		if(i==1){
			a[1]=m;
			used[m]=1;
			Try(i+1);
			return;
		}
		if(used[j]==0){
			a[i]=j;
			used[j]=1;
			if(i==n) inkq();
			else Try(i+1);
			used[j]=0;
		}
		
	}
}
int main(){
	cin>>n>>m;
	Try(1);
}